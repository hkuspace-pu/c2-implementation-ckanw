<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 背景顏色 -->
    <solid android:color="#000000"/> <!-- 黑色背景 -->

    <!-- 邊框 -->
    <stroke
        android:width="1dp"
        android:color="#FFD700"/> <!-- 金色邊框 -->

    <!-- 圓角 -->
    <corners android:radius="8dp"/>

    <!-- 內距 -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp"/>
</shape>