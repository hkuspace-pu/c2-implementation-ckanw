<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animationCache="true"
    android:background="@drawable/jpeg__5_"
    tools:context=".ui.staff.StaffMenuDetailActivity">

    <Button
        android:id="@+id/btnback"
        android:layout_width="71dp"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:alpha="0"
        android:text="Button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/imageBack"
        app:layout_constraintTop_toTopOf="@+id/imageBack" />

    <ImageView
        android:id="@+id/imageBack"
        android:layout_width="79dp"
        android:layout_height="89dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.048"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView12"
        app:srcCompat="@android:drawable/ic_menu_revert" />





    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <View
        android:id="@+id/viewBG"
        android:layout_width="412dp"
        android:layout_height="56dp"
        android:layout_marginTop="44dp"
        android:background="#4E4E4E"
        app:layout_constraintTop_toBottomOf="@+id/imageBack"
        tools:layout_editor_absoluteX="-2dp" />

    <android.widget.Button
        android:id="@+id/btnstaffcancelmenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:background="@drawable/shape_capsule2"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:text="Cancel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.125"
        app:layout_constraintStart_toEndOf="@+id/btnstaffconfirmmenu" />

    <android.widget.Button
        android:id="@+id/btnstaffconfirmmenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:background="@drawable/shape_capsule2"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:text="Confirm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnstaffnotice"
        android:layout_width="83dp"
        android:layout_height="59dp"
        android:layout_marginTop="4dp"
        android:alpha="0"
        android:text="btncustomernotice"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.887"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imageView" />


    <ImageView
        android:id="@+id/imageView"
        android:layout_width="96dp"
        android:layout_height="60dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@android:drawable/ic_dialog_email"
        tools:layout_editor_absoluteY="-3dp" />

    <ImageView
        android:id="@+id/imageView12"
        android:layout_width="63dp"
        android:layout_height="57dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.045"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/burger_menu"
        tools:layout_editor_absoluteY="0dp" />

    <Button
        android:id="@+id/btnstaffullmenu"
        android:layout_width="61dp"
        android:layout_height="60dp"
        android:alpha="0"
        android:text="btnstaffullmenu"
        app:layout_constraintEnd_toStartOf="@+id/imageView"
        app:layout_constraintHorizontal_bias="0.059"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guideline" />

    <FrameLayout
        android:id="@+id/StaffFrame"
        android:layout_width="415dp"
        android:layout_height="252dp"
        app:layout_constraintTop_toBottomOf="@+id/button5"
        tools:layout_editor_absoluteX="-5dp" />

    <Button
        android:id="@+id/button5"
        android:layout_width="74dp"
        android:layout_height="47dp"
        android:layout_marginTop="2dp"
        android:alpha="0"
        android:text="Button"
        app:layout_constraintTop_toBottomOf="@+id/viewBG"
        tools:layout_editor_absoluteX="5dp" />

    <Button
        android:id="@+id/button6"
        android:layout_width="75dp"
        android:layout_height="45dp"
        android:layout_marginStart="4dp"
        android:alpha="0"
        android:text="Button6"
        app:layout_constraintStart_toEndOf="@+id/button5"
        app:layout_constraintTop_toBottomOf="@+id/viewBG" />

    <Button
        android:id="@+id/button7"
        android:layout_width="69dp"
        android:layout_height="49dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="2dp"
        android:alpha="0"
        android:text="Button7"
        app:layout_constraintStart_toEndOf="@+id/button6"
        app:layout_constraintTop_toBottomOf="@+id/viewBG" />

    <TextView
        android:id="@+id/textView36"
        android:layout_width="73dp"
        android:layout_height="47dp"
        android:gravity="center"
        android:text="Starter"
        android:textColor="#A5A5A5"
        android:textSize="22dp"
        app:layout_constraintStart_toStartOf="@+id/button5"
        app:layout_constraintTop_toBottomOf="@+id/viewBG" />

    <TextView
        android:id="@+id/textView38"
        android:layout_width="73dp"
        android:layout_height="47dp"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:text="Main"
        android:textColor="#A5A5A5"
        android:textSize="25dp"
        app:layout_constraintStart_toEndOf="@+id/textView36"
        app:layout_constraintTop_toBottomOf="@+id/viewBG" />

    <TextView
        android:id="@+id/textView39"
        android:layout_width="73dp"
        android:layout_height="47dp"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:text="Dessert"
        android:textColor="#A5A5A5"
        android:textSize="20dp"
        app:layout_constraintStart_toEndOf="@+id/textView38"
        app:layout_constraintTop_toBottomOf="@+id/viewBG" />

    <View
        android:id="@+id/view12"
        android:layout_width="390dp"
        android:layout_height="75dp"
        android:background="#4E4E4E"
        app:layout_constraintBottom_toTopOf="@+id/btnstaffconfirmmenu"
        app:layout_constraintTop_toBottomOf="@+id/StaffFrame"
        app:layout_constraintVertical_bias="0.619"
        tools:layout_editor_absoluteX="15dp" />

    <TextView
        android:id="@+id/textView46"
        android:layout_width="113dp"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Dessert"
        android:textColor="#A5A5A5"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@+id/textView45"
        app:layout_constraintTop_toTopOf="@+id/view12" />

    <TextView
        android:id="@+id/textView44"
        android:layout_width="113dp"
        android:layout_height="46dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Starter"
        android:textColor="#A5A5A5"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@+id/view12"
        app:layout_constraintTop_toTopOf="@+id/view12" />

    <TextView
        android:id="@+id/textView45"
        android:layout_width="113dp"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Main"
        android:textColor="#A5A5A5"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@+id/textView44"
        app:layout_constraintTop_toTopOf="@+id/view12" />

    <EditText
        android:id="@+id/editTextName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:ems="10"
        android:inputType="text"
        android:text="Set A"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@+id/viewBG"
        app:layout_constraintTop_toTopOf="@+id/viewBG" />

    <EditText
        android:id="@+id/editTextPrice"
        android:layout_width="133dp"
        android:layout_height="44dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="12dp"
        android:ems="10"
        android:inputType="number"
        android:text="200.00"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@+id/editTextName"
        app:layout_constraintTop_toTopOf="@+id/viewBG" />

    <TextView
        android:id="@+id/textView33"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="8dp"
        android:text="CLEAR"
        android:textColor="#FFEB3B"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/viewBG"
        app:layout_constraintStart_toEndOf="@+id/textView34"
        app:layout_constraintTop_toBottomOf="@+id/imageBack"
        app:layout_constraintVertical_bias="0.555" />

    <TextView
        android:id="@+id/textView34"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="252dp"
        android:layout_marginBottom="8dp"
        android:text="RESET"
        android:textColor="#FFEB3B"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/viewBG"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageBack"
        app:layout_constraintVertical_bias="0.555" />

    <Button
        android:id="@+id/btnstaffreset"
        android:layout_width="70dp"
        android:layout_height="28dp"
        android:layout_marginStart="244dp"
        android:layout_marginTop="17dp"
        android:text="Button"
        android:alpha="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnback" />

    <Button
        android:id="@+id/btnstaffclear2"
        android:layout_width="58dp"
        android:layout_height="24dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="84dp"
        android:text="Button"
        android:alpha="0"
        app:layout_constraintStart_toEndOf="@+id/textView34"
        app:layout_constraintTop_toTopOf="@+id/btnback" />

</androidx.constraintlayout.widget.ConstraintLayout>

